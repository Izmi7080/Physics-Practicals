--- !u!114 &1505987927
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1505987920}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a40ac5d13534883468c01b3086c532c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StepController
  mode: 0
  director: {fileID: 1505987926}
  steps:
  - id: setup
    title: Assemble the water bath
    cameraAnchor: Overview
    guidedHint: Take tripod, gauze and beaker from the tray. Drag them onto the green
      destinations in that order.
  - id: water
    title: Fill the beaker
    cameraAnchor: Preparation
    guidedHint: Move the beaker below the tap. Fill about 100 mL, stop the tap, then
      return the beaker to the gauze.
  - id: seal
    title: Seal one capillary end
    cameraAnchor: Burner
    guidedHint: Take the capillary from the tray. Drag one end to the blue flame,
      then let it cool.
  - id: sample
    title: Load naphthalene
    cameraAnchor: Mortar
    guidedHint: Take Sample from the tray, then drag it from the container into the
      mortar.
  - id: grind
    title: Grind the sample
    cameraAnchor: Mortar
    guidedHint: Take out the pestle and place it in the mortar. Hold Grind to crush
      the sample.
  - id: pack
    title: Fill and pack the capillary
    cameraAnchor: Capillary
    guidedHint: Collect a compact 10 mm sample column. Drag into powder again if
      needed, then tap the tube to settle it.
  - id: attach
    title: Attach the capillary
    cameraAnchor: Attachment
    guidedHint: Drag the capillary beside the bulb, then select the thread.
  - id: immerse
    title: Clamp and immerse
    cameraAnchor: Immersion
    guidedHint: Place the thermometer in the clamp. Slide vertically. Keep sample
      submerged, clear of glass, and band above water.
  - id: ignite
    title: Light the burner
    cameraAnchor: Burner
    guidedHint: Tap Light burner. A blue flame appears.
  - id: heat
    title: Heat, stir, and observe
    cameraAnchor: Heating
    guidedHint: "Take out the stirrer, place it, then hold Stir. Use 4 \xB0C/min
      to warm; near 75 \xB0C reduce to 1 \xB0C/min. Mark first and final melting."
  - id: shutdown
    title: Switch off
    cameraAnchor: Heating
    guidedHint: Turn off the burner before completing the notebook.
  - id: notebook
    title: Complete the notebook
    cameraAnchor: Overview
    guidedHint: Read the captured scales. Enter T1 and T2 and write your conclusion.
  currentIndex: -1
  autoStart: 0
  viewToggleButton: {fileID: 0}
