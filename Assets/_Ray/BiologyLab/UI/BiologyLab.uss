
.app { flex-grow:1; background-color:rgb(235,216,170); background-image:url("ScienceBackground.png"); -unity-background-scale-mode:scale-and-crop; }
.safe { flex-grow:1; }
.hidden { display:none; }
Label { color:rgb(33,60,43); white-space:normal; }
.welcome { flex-grow:1; align-items:center; justify-content:center; padding:28px; }
.eyebrow { font-size:15px; letter-spacing:3px; -unity-font-style:bold; }
.brand { flex-direction:row; align-items:center; justify-content:center; margin-top:28px; }
.brand-word { font-size:112px; -unity-font-style:bold; letter-spacing:-5px; }
.heart { width:105px; height:135px; background-image:url("Heart.svg"); margin:0 5px; }
.lab-word { font-size:39px; -unity-font-style:bold; color:rgb(177,67,51); letter-spacing:13px; margin-top:-12px; margin-left:18px; }
.welcome-subtitle { font-size:23px; margin-top:24px; margin-bottom:30px; }
Button { border-width:0; -unity-text-align:middle-center; white-space:normal; }
.action { background-color:rgb(39,84,57); color:rgb(255,249,227); border-radius:13px; font-size:22px; -unity-font-style:bold; padding:16px 24px; min-height:64px; margin:0; border-bottom-width:5px; border-bottom-color:rgb(216,151,56); }
.action:hover { background-color:rgb(52,105,72); }
.action:focus { border-top-width:2px; border-left-width:2px; border-right-width:2px; border-top-color:rgb(222,160,59); border-left-color:rgb(222,160,59); border-right-color:rgb(222,160,59); }
.start { width:330px; min-height:78px; font-size:27px; }
.welcome-quit { position:absolute; top:20px; right:20px; flex-direction:row; align-items:center; justify-content:center; min-width:112px; min-height:64px; padding:10px 16px; }
.welcome-quit Label { color:rgb(255,249,227); font-size:19px; margin-left:9px; }
.power-icon { width:27px; height:27px; background-image:url("Power.svg"); flex-shrink:0; }
.portrait .welcome-quit { top:16px; right:16px; }
.welcome-footer { font-size:12px; letter-spacing:2px; margin-top:36px; }
.study { flex-grow:1; padding:22px 30px; }
.topbar { flex-direction:row; align-items:center; height:50px; flex-shrink:0; margin-bottom:18px; }
.quiet { background-color:rgba(0,0,0,0); color:rgb(39,84,57); font-size:17px; padding:12px; margin:0; min-height:48px; }
.quiet:hover { background-color:rgba(39,84,57,0.1); }
.top-brand { flex-grow:1; -unity-text-align:middle-center; -unity-font-style:bold; letter-spacing:4px; font-size:19px; }
.top-tag { font-size:12px; letter-spacing:2px; }
.workspace { flex-grow:1; flex-direction:row; min-height:0; }
.notebook { width:45%; margin-right:24px; background-color:rgb(255,248,226); border-radius:8px; border-left-width:12px; border-left-color:rgb(43,66,45); padding:16px; }
.paper { background-color:rgb(107,135,34); flex-grow:1; padding:26px; border-radius:4px; }
.paper Label { color:rgb(255,249,226); }
.paper-kicker { font-size:12px; letter-spacing:3px; margin-bottom:20px; }
.paper-heading { font-size:40px; -unity-font-style:bold; margin-bottom:20px; }
.guide { font-size:23px; margin-bottom:24px; }
.study-label { font-size:25px; -unity-font-style:italic; }
.rule { height:2px; background-color:rgba(255,248,226,0.4); margin-top:10px; margin-bottom:22px; }
.anatomy { margin-bottom:17px; font-size:21px; }
.secondary { background-color:rgb(59,76,32); }
.hint { font-size:15px; margin-top:8px; }
.paper-back { color:rgb(255,249,226); margin-top:14px; }
.specimen { flex-grow:1; flex-basis:0; background-color:rgb(240,222,182); border-radius:18px; padding:20px; min-height:0; }
.specimen-top { flex-direction:row; justify-content:space-between; }
.view-label { font-size:14px; color:rgb(96,115,72); }
.frog-image { flex-grow:1; min-height:100px; -unity-background-scale-mode:scale-to-fit; }
.specimen-bottom { align-items:center; }
.specimen-title { font-size:29px; -unity-font-style:bold; letter-spacing:6px; }
.specimen-note { font-size:14px; margin-top:7px; -unity-text-align:middle-center; }
.compact .study { padding:12px 16px; }
.compact .welcome { padding:20px; }
.compact .brand { margin-top:14px; }
.compact .brand-word { font-size:82px; }
.compact .heart { width:78px; height:105px; }
.compact .lab-word { font-size:28px; }
.compact .welcome-subtitle { font-size:20px; margin-top:16px; margin-bottom:20px; }
.compact .start { min-height:68px; font-size:24px; }
.compact .welcome-footer { margin-top:22px; }
.compact .paper { padding:18px; }
.compact .paper-heading { font-size:27px; margin-bottom:12px; }
.compact .paper-kicker, .compact .study-label { display:none; }
.compact .rule { margin-top:0; margin-bottom:12px; }
.compact .guide { font-size:19px; margin-bottom:16px; }
.compact .anatomy { font-size:19px; min-height:64px; padding:10px; margin-bottom:12px; }
.compact .topbar { margin-bottom:8px; height:44px; }
.compact .specimen { padding:12px; }
.portrait .brand-word { font-size:62px; letter-spacing:-3px; }
.portrait .heart { width:62px; height:85px; }
.portrait .welcome { padding:20px; }
.portrait .eyebrow { font-size:11px; letter-spacing:1px; -unity-text-align:middle-center; }
.portrait .welcome-subtitle { font-size:19px; }
.portrait .welcome-footer { font-size:10px; -unity-text-align:middle-center; }
.portrait .start { width:290px; min-height:76px; }
.portrait .workspace { flex-direction:column; }
.portrait .notebook { width:auto; height:55%; margin-right:0; margin-bottom:12px; padding:10px; }
.portrait .paper { padding:18px; }
.portrait .paper-heading { font-size:29px; margin-bottom:12px; }
.portrait .paper-kicker { margin-bottom:12px; }
.portrait .guide { font-size:19px; margin-bottom:16px; }
.portrait .anatomy { min-height:72px; font-size:20px; margin-bottom:12px; }
.portrait .quiet { min-height:64px; }
.portrait .top-tag { display:none; }
.portrait .top-brand { font-size:15px; letter-spacing:2px; }
.portrait .specimen-title { font-size:20px; }
.portrait .specimen-note { font-size:12px; }
.anatomy-screen { flex-grow:1; padding:16px 24px; }
.anatomy-topbar { flex-direction:row; align-items:center; height:74px; flex-shrink:0; }
.anatomy-home { min-width:130px; min-height:62px; font-size:22px; padding:10px 16px; }
.anatomy-title { flex-grow:1; -unity-text-align:middle-center; font-size:25px; -unity-font-style:bold; margin-right:130px; }
.diagram { flex-grow:1; min-height:0; position:relative; }
.anatomy-image { position:absolute; left:0; right:0; top:0; bottom:0; }
.anatomy-annotations { position:absolute; left:0; right:0; top:0; bottom:0; }
.anatomy-marker { position:absolute; color:rgb(27,96,122); -unity-font-style:bold; font-size:24px; -unity-text-align:middle-center; white-space:normal; padding:4px; }
.side-caption { position:absolute; color:rgb(69,48,62); -unity-font-style:bold; font-size:25px; -unity-text-align:middle-center; }
.portrait .anatomy-screen { padding:10px 8px; }
.portrait .anatomy-topbar { height:76px; }
.portrait .anatomy-home { min-width:100px; min-height:60px; font-size:20px; }
.portrait .anatomy-title { font-size:22px; margin-right:0; }
.portrait .anatomy-marker { font-size:20px; }
.portrait .side-caption { font-size:18px; }
.compact .anatomy-topbar { height:64px; }
.compact .anatomy-home { min-height:60px; font-size:20px; }
.compact .anatomy-marker { font-size:20px; }
.compact .side-caption { font-size:22px; }
.transition { position:absolute; left:0; right:0; top:0; bottom:0; background-color:rgb(235,216,170); align-items:center; justify-content:center; }
.transition-kicker { font-size:17px; letter-spacing:3px; }
.transition-label { font-size:36px; -unity-font-style:bold; margin-top:22px; -unity-text-align:middle-center; }
.transition-note { font-size:18px; margin-top:14px; }
.transition-track { width:260px; height:5px; background-color:rgba(39,84,57,0.18); margin-top:28px; border-radius:3px; }
.transition-progress { height:5px; width:0; background-color:rgb(39,84,57); border-radius:3px; }
.internal-top { flex-direction:row; align-items:center; }
.internal-top .action { min-height:60px; padding:10px 15px; margin-left:10px; }
.internal-quit { width:64px; align-items:center; justify-content:center; }
.internal-view .anatomy-title { margin-right:0; font-size:23px; }
.internal-ui { position:absolute; left:0; right:0; top:0; bottom:0; }
.layer-menu { position:absolute; left:8px; top:22%; width:195px; }
.layer-button { margin-bottom:13px; min-height:60px; font-size:21px; padding:12px; background-color:rgb(113,117,62); border-left-width:5px; border-left-color:rgba(0,0,0,0); }
.layer-button.selected { background-color:rgb(39,84,57); border-left-color:rgb(222,160,59); }
.internal-note { position:absolute; left:160px; right:160px; bottom:116px; -unity-text-align:middle-center; font-size:15px; }
.camera-controls { position:absolute; left:0; right:0; bottom:0; height:142px; }
.camera-pad { position:absolute; bottom:0; width:142px; height:142px; border-radius:72px; background-color:rgb(255,245,219); border-width:2px; border-color:rgb(216,151,56); }
.zoom-pad { left:0; }
.move-pad { right:0; }
.pad-button { position:absolute; width:46px; height:46px; min-height:46px; margin:0; padding:0; font-size:26px; color:rgb(39,84,57); background-color:rgba(0,0,0,0); border-radius:23px; }
.pad-button:hover { background-color:rgba(39,84,57,.15); }
.pad-top { top:1px; left:46px; }
.pad-bottom { bottom:1px; left:46px; }
.pad-left { top:46px; left:1px; }
.pad-right { top:46px; right:1px; }
.pad-center { top:46px; left:46px; background-color:rgb(216,151,56); color:rgb(255,249,227); }
.study-actions { position:absolute; bottom:6px; left:160px; right:160px; flex-direction:row; justify-content:center; }
.study-actions .action { margin:0 8px; min-height:62px; font-size:20px; padding:12px 16px; }
.label-bank { position:absolute; top:18px; right:0; bottom:156px; width:225px; background-color:rgba(255,248,226,.94); border-radius:10px; padding:12px; }
.bank-heading { font-size:13px; letter-spacing:1px; -unity-font-style:bold; }
.label-score { font-size:16px; margin:8px 0; }
.organ-labels { flex-grow:1; min-height:0; }
.organ-source { flex-shrink:0; min-height:48px; margin:0 0 7px; padding:8px; font-size:17px; color:rgb(255,249,227); background-color:rgb(86,103,52); border-radius:5px; -unity-font-style:bold; -unity-text-outline-width:1px; -unity-text-outline-color:rgb(32,52,33); }
.organ-source:hover { background-color:rgb(107,135,64); }
.organ-source.used { opacity:.45; }
.organ-target { position:absolute; padding:2px 5px; margin:0; font-size:15px; color:rgb(255,249,227); background-color:rgba(105,102,65,.88); border-radius:5px; border-width:1px; border-color:rgb(169,150,93); -unity-font-style:bold; -unity-text-outline-width:1px; -unity-text-outline-color:rgb(42,53,36); }
.organ-target.drop-hover { background-color:rgb(178,134,45); border-color:rgb(255,234,135); }
.organ-target.correct { background-color:rgb(39,128,65); border-color:rgb(112,226,133); }
.organ-target.incorrect { background-color:rgb(173,54,46); border-color:rgb(249,133,113); }
.organ-leaders { position:absolute; left:0; right:0; top:0; bottom:0; }
.drag-ghost { position:absolute; width:170px; height:44px; padding:7px; font-size:18px; background-color:rgb(39,84,57); color:rgb(255,249,227); border-radius:6px; -unity-text-align:middle-center; -unity-font-style:bold; -unity-text-outline-width:1px; -unity-text-outline-color:rgb(21,42,28); }
.portrait .internal-top .action { font-size:16px; min-height:58px; padding:8px; margin-left:6px; }
.portrait .internal-view .anatomy-home { min-width:83px; font-size:17px; }
.portrait .internal-view .anatomy-title { font-size:17px; }
.portrait .internal-quit { width:54px; }
.portrait .layer-menu { top:6px; left:0; right:0; width:auto; flex-direction:row; flex-wrap:wrap; }
.portrait .layer-button { width:48%; min-height:60px; margin:0 1% 9px; font-size:19px; }
.portrait .study-actions { bottom:144px; left:0; right:0; }
.portrait .study-actions .action { flex-grow:1; font-size:18px; min-height:60px; margin:0 4px; padding:8px; }
.portrait .internal-note { left:8px; right:8px; bottom:218px; font-size:13px; }
.portrait .label-bank { top:auto; bottom:152px; left:8px; right:8px; width:auto; height:180px; padding:8px; }
.portrait .label-bank .bank-heading { display:none; }
.portrait .label-score { font-size:14px; margin:0 0 4px; }
.portrait .label-bank .quiet { position:absolute; right:8px; top:0; min-height:30px; padding:5px; font-size:14px; }
.portrait .organ-source { min-height:46px; font-size:17px; }
.portrait .organ-target { font-size:15px; }
.portrait .labeling-mode .internal-note { bottom:336px; font-size:12px; }
.compact .layer-menu { top:0; width:185px; }
.compact .layer-button { min-height:54px; margin-bottom:6px; font-size:19px; padding:8px; }
.compact .study-actions .action { font-size:17px; min-height:56px; padding:10px; }
.compact .internal-note { display:none; }
.layer-button { flex-direction:row; align-items:center; justify-content:space-between; min-height:54px; }
.layer-caption { color:rgb(255,249,227); -unity-font-style:bold; font-size:20px; }
.layer-icon { width:24px; height:24px; flex-shrink:0; margin-left:8px; }
.muscle-icon { background-image:url("MuscleIcon.svg"); }
.bone-icon { background-image:url("BoneIcon.svg"); }
.organ-icon { background-image:url("OrganIcon.svg"); }
.clipboard-icon { background-image:url("ClipboardIcon.svg"); }
.pad-button { align-items:center; justify-content:center; }
.direction-icon { width:22px; height:22px; background-image:url("DirectionArrow.svg"); }
.arrow-right { rotate:90deg; }
.arrow-down { rotate:180deg; }
.arrow-left { rotate:270deg; }
.internal-view .anatomy-topbar { height:60px; }
.internal-view .anatomy-home { min-width:106px; min-height:48px; font-size:19px; padding:8px 12px; }
.internal-view .internal-top .action { min-height:48px; font-size:18px; padding:8px 12px; }
.internal-view .internal-top .internal-quit { width:52px; padding:8px; }
.internal-view .internal-quit .power-icon { width:23px; height:23px; }
.compact .layer-menu { width:170px; }
.compact .layer-button { min-height:44px; height:44px; margin-bottom:6px; padding:6px 10px; }
.compact .layer-caption { font-size:17px; }
.compact .layer-icon { width:22px; height:22px; }
.portrait .layer-caption { font-size:18px; }
.portrait .internal-view .anatomy-home { min-width:78px; font-size:16px; }
.portrait .internal-view .internal-top .action { font-size:15px; padding:8px; }
.start:hover { background-color:rgb(55,112,76); }
.labeling-mode .label-bank { top:4px; bottom:120px; background-color:rgba(139,124,76,.3); border-radius:2px; padding:10px; }
.label-bank #reset-labels { display:none; }
.organ-labels #unity-vertical-scroller { width:20px; }
.organ-labels #unity-low-button, .organ-labels #unity-high-button { display:none; }
.organ-labels .unity-base-slider__tracker { background-color:rgb(245,239,219); border-radius:0; }
.organ-labels .unity-base-slider__dragger { background-color:rgb(230,154,37); border-radius:0; border-width:0; min-height:40px; }
.organ-target { background-color:rgba(143,130,78,.68); border-radius:2px; }
.compact .organ-source { min-height:36px; margin-bottom:5px; padding:5px; font-size:16px; }
.compact .label-bank .bank-heading { display:none; }
.compact .label-score { margin:0 0 8px; font-size:14px; }
.compact .labeling-mode .camera-pad { scale:.75; transform-origin:bottom left; }
.compact .labeling-mode .move-pad { transform-origin:bottom right; }
.portrait .labeling-mode .label-bank { top:auto; bottom:152px; height:180px; }
.portrait .internal-view .internal-top #retry-exam { font-size:13px; padding:6px; }
.portrait .internal-view .anatomy-title { font-size:14px; }
.systems-menu { position:absolute; left:8px; top:10%; width:150px; }
.systems-menu .action { min-height:42px; margin-bottom:8px; font-size:16px; }
.system-label { position:absolute; color:rgb(29,83,121); font-size:16px; -unity-font-style:bold; -unity-text-align:middle-center; -unity-text-outline-width:1px; -unity-text-outline-color:rgb(255,245,215); background-color:rgba(255,245,215,0.7); border-radius:5px; }
.portrait .systems-menu { top:0; left:0; right:0; width:auto; flex-direction:row; flex-wrap:wrap; }
.portrait .systems-menu .action { width:30%; min-height:38px; font-size:13px; margin:2px; }
.portrait .system-label { font-size:12px; }
.portrait .internal-view .internal-top #system-isolate { font-size:12px; padding:5px; }
.systems-right { left:auto; right:8px; top:22%; }
.system-label { font-size:18px; }
.portrait .systems-menu { right:40%; width:auto; }
.portrait .systems-menu .action { width:47%; }
.portrait .systems-right { left:60%; right:0; top:0; }
.portrait .systems-right .action { width:100%; }
.portrait .system-label { font-size:12px; }
.systems-mode .internal-note { display:none; }
.system-label { -unity-text-outline-width:0.4px; color:rgb(20,65,104); }
.systems-menu .action { white-space:nowrap; padding-left:8px; padding-right:8px; }
.systems-menu .action.selected { background-color:rgb(65,110,73); }
/* Keep system menus above the fixed camera pads, including short landscape windows. */
.systems-menu { top:8px; }
.systems-menu .action { height:42px; min-height:42px; padding-top:6px; padding-bottom:6px; margin-bottom:6px; }
.systems-right { top:54px; }
.compact .systems-menu { top:6px; }
.compact .systems-menu .action { height:38px; min-height:38px; margin-bottom:5px; }
.compact .systems-right { top:28px; }
.portrait .systems-menu, .portrait .systems-right { top:0; }
.urogenital-label { font-size:14px; }
.portrait .urogenital-label { font-size:11px; }
.portrait .internal-view .anatomy-title { font-size:12px; }
.portrait .internal-view .internal-top .action { font-size:13px; padding:5px; min-height:44px; margin-left:4px; }
.portrait .internal-view .internal-top .internal-quit { width:40px; padding:5px; }
.organ-study-mode .internal-note { display:none; }
.organ-study-tip { position:absolute; top:16px; left:16px; width:320px; padding:8px 12px; color:rgb(36,86,50); background-color:rgba(255,246,216,.88); border-radius:8px; font-size:17px; -unity-font-style:bold; -unity-text-align:middle-center; }
.organ-study-hand { position:absolute; width:54px; height:74px; background-image:url("StudyHand.svg"); -unity-background-scale-mode:scale-to-fit; }
.organ-index-toggle { position:absolute; top:58px; left:16px; min-height:42px; padding:6px 12px; font-size:15px; }
.organ-index-panel { position:absolute; top:108px; left:16px; bottom:112px; width:246px; padding:9px; background-color:rgba(255,247,222,.96); border-radius:8px; }
.organ-index-heading { color:rgb(39,84,57); -unity-font-style:bold; font-size:16px; margin-bottom:8px; }
.organ-index-list { flex-grow:1; min-height:0; }
.organ-index-item { flex-shrink:0; min-height:40px; margin-bottom:5px; padding:5px 9px; font-size:14px; -unity-text-align:middle-left; }
