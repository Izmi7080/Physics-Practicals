.compact .organ-study-heading { font-size:13px; margin:2px 0; }
.compact .organ-study-copy { font-size:12px; margin-bottom:3px; }
.compact .organ-study-mode .camera-pad { scale:.65; transform-origin:bottom left; }
.compact .organ-study-mode .move-pad { transform-origin:bottom right; }

/* Illustrated welcome screen. All controls remain live UI over the artwork. */
.welcome { position:relative; overflow:hidden; background-color:rgb(251,231,193); padding:0; }
.welcome-decor { position:absolute; left:0; right:0; top:0; bottom:0; background-image:url("WelcomeDecor.svg"); -unity-background-scale-mode:scale-and-crop; }
.welcome-margin-art, .welcome-phone-art { position:absolute; -unity-background-scale-mode:scale-to-fit; }
.welcome-margin-art { opacity:0.27; }
.welcome-dna { left:2%; top:20%; width:14%; height:33%; background-image:url("WelcomeArt/Dna.png"); }
.welcome-leaves { left:1%; bottom:4%; width:18%; height:32%; background-image:url("WelcomeArt/Leaves.png"); }
.welcome-cell { right:2%; bottom:12%; width:18%; height:32%; background-image:url("WelcomeArt/Cell.png"); }
.welcome-phone-art { display:none; }
.welcome-top { position:absolute; left:24px; right:24px; top:22px; height:64px; align-items:center; justify-content:center; }
.welcome-kicker { flex-direction:row; align-items:center; justify-content:center; }
.welcome-kicker-line { width:44px; height:3px; background-color:rgb(193,94,77); border-radius:2px; }
.welcome-kicker-text { margin:0 14px; color:rgb(30,74,48); font-size:19px; letter-spacing:2px; -unity-font-style:bold; -unity-text-align:middle-center; }
.welcome-quit { top:0; right:0; min-width:110px; min-height:56px; padding:9px 15px; border-radius:13px; }
.welcome-quit Label { font-size:18px; }
.welcome-hero { align-items:center; justify-content:center; width:100%; margin-top:28px; }
.welcome-brand-row { flex-direction:row; align-items:center; justify-content:center; width:100%; }
.welcome-logo { align-items:center; justify-content:center; }
.welcome-microscope, .welcome-flask { width:170px; height:178px; flex-shrink:0; -unity-background-scale-mode:scale-to-fit; margin:0 19px; }
.welcome-microscope, .welcome-phone-microscope { background-image:url("WelcomeArt/Microscope.png"); }
.welcome-flask, .welcome-phone-flask { background-image:url("WelcomeArt/Flask.png"); }
.brand { margin-top:0; }
.brand-word { color:rgb(26,70,44); font-size:115px; letter-spacing:-7px; }
.heart { width:110px; height:142px; margin:0 -2px; background-image:url("WelcomeArt/Heart.png"); -unity-background-scale-mode:scale-to-fit; }
.welcome-lab-row { flex-direction:row; align-items:center; justify-content:center; margin-top:-12px; }
.welcome-lab-line { width:66px; height:3px; background-color:rgb(193,94,77); margin:0 15px; }
.lab-word { margin:0; color:rgb(190,83,69); font-size:48px; letter-spacing:9px; }
.welcome-subtitle { color:rgb(32,82,50); font-size:27px; -unity-font-style:italic; margin-top:22px; margin-bottom:32px; -unity-text-align:middle-center; }
.start { width:370px; min-height:86px; font-size:30px; border-radius:18px; border-bottom-width:7px; }
.welcome-footer { position:absolute; bottom:25px; margin:0; color:rgb(76,112,77); font-size:13px; letter-spacing:3px; -unity-text-align:middle-center; }
.compact .welcome { padding:0; }
.compact .welcome-top { top:8px; height:45px; }
.compact .welcome-kicker-text { font-size:13px; letter-spacing:1px; }
.compact .welcome-kicker-line { width:28px; }
.compact .welcome-quit { min-height:43px; min-width:88px; padding:5px 10px; }
.compact .welcome-quit Label { font-size:14px; }
.compact .welcome-quit .power-icon { width:21px; height:21px; }
.compact .welcome-hero { margin-top:16px; }
.compact .welcome-microscope, .compact .welcome-flask { width:119px; height:125px; margin:0 13px; }
.compact .brand-word { font-size:77px; letter-spacing:-5px; }
.compact .heart { width:75px; height:98px; }
.compact .welcome-lab-row { margin-top:-7px; }
.compact .welcome-lab-line { width:42px; margin:0 11px; }
.compact .lab-word { font-size:32px; letter-spacing:6px; }
.compact .welcome-subtitle { font-size:18px; margin-top:11px; margin-bottom:14px; }
.compact .start { width:275px; min-height:60px; font-size:22px; border-bottom-width:5px; }
.compact .welcome-footer { bottom:9px; font-size:10px; letter-spacing:2px; }
.portrait .welcome { padding:0; }
.portrait .welcome-phone-art { display:flex; top:15%; width:28%; height:16%; opacity:0.87; }
.portrait .welcome-phone-microscope { left:15%; }
.portrait .welcome-phone-flask { right:15%; }
.portrait .welcome-dna { left:1%; top:22%; width:14%; height:17%; }
.portrait .welcome-leaves { left:4%; bottom:8%; width:36%; height:19%; }
.portrait .welcome-cell { right:5%; bottom:10%; width:33%; height:17%; }
.portrait .welcome-top { top:12px; left:8px; right:8px; height:70px; justify-content:flex-start; }
.portrait .welcome-kicker { width:70%; justify-content:flex-start; }
.portrait .welcome-kicker-line { display:none; }
.portrait .welcome-kicker-text { margin:0; font-size:11px; letter-spacing:1px; -unity-text-align:middle-left; }
.portrait .welcome-quit { top:0; right:0; min-width:86px; min-height:50px; padding:7px 10px; }
.portrait .welcome-quit Label { font-size:15px; margin-left:5px; }
.portrait .welcome-quit .power-icon { width:21px; height:21px; }
.portrait .welcome-hero { margin-top:0; padding:0 12px; }
.portrait .welcome-microscope, .portrait .welcome-flask { display:none; }
.portrait .brand-word { font-size:62px; letter-spacing:-4px; }
.portrait .heart { width:59px; height:83px; margin:0 -3px; }
.portrait .welcome-lab-row { margin-top:-4px; }
.portrait .welcome-lab-line { width:45px; margin:0 9px; }
.portrait .lab-word { font-size:36px; letter-spacing:6px; }
.portrait .welcome-subtitle { font-size:20px; margin-top:18px; margin-bottom:27px; }
.portrait .start { width:290px; min-height:76px; font-size:24px; }
.portrait .welcome-footer { bottom:22px; left:20px; right:20px; font-size:10px; letter-spacing:1px; }
